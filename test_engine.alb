# ============================================================
#  test_engine.alb - checks the engine really works.
#  Every check prints PASS or FAIL. Run: ./test.sh
# ============================================================

import engine
import easy

PASSN = 0
FAILN = 0

def check(name, ok) {
    if ok {
        PASSN = PASSN + 1
        print "PASS " + name
    } else {
        FAILN = FAILN + 1
        print "FAIL " + name
    }
    return 0
}

engine.engine_init()

# --- fixed-point maths ---
check("fmul one times one", engine.fmul(4096, 4096) == 4096)
check("fmul two times half", engine.fmul(8192, 2048) == 4096)
check("fdiv one over half", engine.fdiv(4096, 2048) == 8192)
check("fdiv by zero is safe", engine.fdiv(4096, 0) == 0)

# --- wobble table (sine and cosine) ---
check("sin 0 is 0", engine.sin_a(0) == 0)
check("cos 0 is one", engine.cos_a(0) == 4096)
check("sin quarter turn is one", engine.sin_a(64) == 4096)
check("sin wraps around", engine.sin_a(256 + 64) == 4096)
check("sin negative angle", engine.sin_a(0 - 64) == 0 - 4096)

# --- 15-bit colour ---
check("pack red", engine.pack(31, 0, 0) == 31744)
check("unpack red", engine.red_of(engine.pack(31, 2, 3)) == 31)
check("unpack green", engine.grn_of(engine.pack(1, 17, 3)) == 17)
check("unpack blue", engine.blu_of(engine.pack(1, 2, 29)) == 29)
check("shade black stays black", engine.shade_col(engine.pack(31, 31, 31), 0) == 0)
check("shade full keeps colour", engine.shade_col(engine.pack(10, 20, 30), 256) == engine.pack(10, 20, 30))

# --- the screen is the PS1 size and fits the RAM budget ---
check("screen is 320x240", engine.W == 320 and engine.H == 240)
check("framebuffer size", len(engine.FB) == 76800)
check("framebuffer bytes under 250MB", len(engine.FB) * 2 < 250 * 1024 * 1024)
check("triangle cap under 250MB budget", engine.MAX_TRIS <= 600)
check("textures are tiny", len(engine.TEXTURES) >= 4 and len(engine.TEXTURES) <= 8)
check("one texture is 32x32", len(engine.TEXTURES[0]) == 1024)

# --- flat triangle painter ---
tri = {}
tri.x0 = 20
tri.y0 = 20
tri.x1 = 300
tri.y1 = 40
tri.x2 = 160
tri.y2 = 220
tri.col = engine.pack(31, 0, 0)
tri.tex = -1
tri.shade = 256
tri.mode = 0
tri.s0 = 256
tri.s1 = 256
tri.s2 = 256
tri.u0 = 0
tri.v0 = 0
tri.u1 = 0
tri.v1 = 0
tri.u2 = 0
tri.v2 = 0
tri.z = 100
filled = engine.raster_flat(tri)
check("flat triangle fills pixels", filled > 15000 and filled < 40000)
check("flat triangle centre pixel", engine.FB[100 * 320 + 160] == engine.pack(31, 0, 0))
check("flat triangle misses corner", engine.FB[0] != engine.pack(31, 0, 0))

# --- smooth (gouraud) triangle painter ---
tri.col = engine.pack(31, 31, 31)
tri.s0 = 256
tri.s1 = 128
tri.s2 = 32
filled2 = engine.raster_gouraud(tri)
check("gouraud triangle fills pixels", filled2 == filled)
mid = engine.FB[100 * 320 + 160]
check("gouraud centre is shaded grey", engine.red_of(mid) > 8 and engine.red_of(mid) < 30)

# --- textured triangle painter (the warpy PS1 kind) ---
tri3 = {}
tri3.x0 = 20
tri3.y0 = 20
tri3.x1 = 300
tri3.y1 = 40
tri3.x2 = 160
tri3.y2 = 220
tri3.col = engine.pack(31, 31, 31)
tri3.tex = 0
tri3.shade = 256
tri3.mode = 2
tri3.s0 = 256
tri3.s1 = 256
tri3.s2 = 256
tri3.u0 = 0
tri3.v0 = 0
tri3.u1 = 4096
tri3.v1 = 0
tri3.u2 = 0
tri3.v2 = 4096
tri3.z = 100
filled3 = engine.raster_tex(tri3)
check("textured triangle fills pixels", filled3 == filled)
tp = engine.FB[100 * 320 + 160]
check("textured pixel is a grass green", tp == engine.pack(7, 23, 7) or tp == engine.pack(5, 18, 5))

# --- 3D: a point in front lands in the middle ---
engine.set_camera(0, 0, 0, 0, 0)
pt = engine.project_point(0, 0, 20000)
check("point ahead projects to centre", pt != null and pt[0] == 160 and pt[1] == 120)
behind = engine.project_point(0, 0, 0 - 20000)
check("point behind is hidden", behind == null)

# --- a whole cube renders, and only the near faces show ---
engine.set_camera(0, 8192, 0 - 30000, 0, 0)
cols = [engine.pack(31, 5, 5), engine.pack(5, 31, 5), engine.pack(5, 5, 31), engine.pack(31, 31, 5), engine.pack(31, 5, 31), engine.pack(5, 31, 31)]
cube = engine.make_thing(engine.mesh_box(8192, 8192, 8192, cols), 0, 8192, 0, 0)
drawn = engine.render([cube])
check("cube draws front face only", drawn == 2)
check("cube paints many pixels", engine.STATE.pixels > 5000)
check("far faces were culled", engine.STATE.tris_seen == 12 and drawn < 12)

# --- a gem renders (its faces point out, not in) ---
engine.set_camera(0, 6000, 0 - 20000, 0, 0)
gem1 = engine.make_thing(engine.mesh_gem(3000, 5000, engine.pack(13, 30, 31)), 0, 5000, 0, 0)
gem_drawn = engine.render([gem1])
check("gem draws its near faces", gem_drawn >= 3)
check("gem paints pixels", engine.STATE.pixels > 1000)

# --- the ground shows from a chasing camera ---
engine.set_camera(0, 14000, 0 - 30000, 0, 0 - 13)
gnd = engine.make_thing(engine.mesh_ground(22 * 4096, 0, engine.pack(7, 23, 7)), 0, 0, 0, 0)
engine.render([gnd])
check("ground paints the floor", engine.STATE.pixels > 20000)

# --- words on the screen ---
engine.clear_sky()
engine.draw_text(10, 10, "HI", engine.pack(31, 31, 31), 2)
ink = 0
i = 0
while i < 76800 {
    if engine.FB[i] == engine.pack(31, 31, 31) {
        ink = ink + 1
    }
    i = i + 1
}
check("letters paint ink", ink > 30)

# --- sparkles live in a fixed pool ---
engine.spawn_sparkle(0, 5000, 20000, engine.pack(31, 29, 6), 10)
check("sparkles spawn", len(engine.PARTS) == 10)
s = 0
while s < 40 {
    engine.step_parts()
    s = s + 1
}
check("sparkles die and free the pool", len(engine.PARTS) == 0)

# --- the kindergarten words ---
check("colour red by name", easy.color_of("red") == engine.pack(31, 5, 5))
check("colour names ignore case", easy.color_of("SKY") == easy.color_of("sky"))
check("unknown colour is safe pink", easy.color_of("banana") == engine.pack(31, 16, 24))
easy.start_quiet("TEST WORLD")
easy.make_ground("grass")
easy.add_tree(3, 2)
easy.add_gem(0, -2)
easy.put_player(0, -6, "red")
check("easy world has things", len(easy.WORLD.items) >= 5)
check("easy gem counted", easy.WORLD.gems_total == 1)
easy.draw_world()
check("easy world draws triangles", engine.STATE.tris_drawn > 5)
check("easy world paints the ground", engine.STATE.pixels > 20000)

print "TESTS PASS " + str(PASSN) + " FAIL " + str(FAILN)
