name = "AlbiPSX"
version = "1.2.0"
entry = "games/game.alb"
language = "Albish 2.0"
kind = "game engine"
graphics = "PS1 style: 320x240, 15-bit colour, fixed point, wobbly vertices, warpy textures; the Linux program adds a z-buffer + near-plane clipping"
ram_limit_mb = 250
ps1_ram = "the Linux program peaks ~1.2 MB in-game: inside PS1 main RAM (2 MB) and VRAM (1 MB)"
modules = ["engine", "easy"]
program = "engine/albipsx (native C binary, PS1-sized: ~1.2 MB peak in-game, sources in engine/native/; Go prototype kept in engine/native-go/)"
examples = ["games/game.alb", "games/my_first_game.alb", "games/autoplay.alb"]
